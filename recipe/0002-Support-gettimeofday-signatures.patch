From b4bb0a57e1c591710723e802a219b6eb8334e58b Mon Sep 17 00:00:00 2001
From: Uwe Korn <uwelk@xhochy.com>
Date: Sat, 13 Jan 2024 20:12:33 +0000
Subject: [PATCH 2/2] Support gettimeofday signatures before and after glibc 2.31

---
 datefudge.c | 10 ++++++++--
 1 file changed, 8 insertions(+), 2 deletions(-)

diff --git a/datefudge.c b/datefudge.c
index 0e3ac0f..164e25a 100644
--- a/datefudge.c
+++ b/datefudge.c
@@ -74,8 +74,14 @@ time_t time(time_t *tloc) {
   return res;
 }
 
-int gettimeofday(struct timeval *tv, void *tz) {
-  static int (*libc_gettimeofday)(struct timeval *, void *) = NULL;
+#if __GLIBC_PREREQ(2, 31)
+typedef void timezone_arg_t;
+#else
+typedef struct timezone timezone_arg_t;
+#endif
+
+int gettimeofday(struct timeval *tv, timezone_arg_t *tz) {
+  static int (*libc_gettimeofday)(struct timeval *, timezone_arg_t *) = NULL;
 
   if (!libc_gettimeofday)
     libc_gettimeofday = (typeof(libc_gettimeofday))dlsym(RTLD_NEXT, __func__);
